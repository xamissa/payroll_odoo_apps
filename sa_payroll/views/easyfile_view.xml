<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_easyfile_view_form" model="ir.ui.view">
        <field name="name">easyfile.report.form</field>
        <field name="model">easyfile.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name='get_payslips' type='object' string='Get Payslip'/>
                    <button name='generare_report' type='object' string='EMP501 file'/>
                    <button name="action_generate_csv" string="Bank Bulk Payment" type="object"/>
                    <button name='emp_201_report' type='object' string='EMP201 file'/>
                </header>
                <sheet string="EasyFile">
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name='start_date'/>
                            <field name='end_date'/>
                        </group>
                        <group>
                            <field name='employee_ids' widget='many2many_tags'/>
                            <field name='emp_201'/>
                            <field name='emp_501'/>
                        </group>
                    </group>
                    <group>
                        <field name='payslip_ids'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="easyfilereport_tree" model="ir.ui.view">
        <field name="name">Easyfile Report</field>
        <field name="model">easyfile.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Name"/>
                <field name="start_date" string="Start Date"/>
                <field name="end_date" string="End Date"/>
            </tree>
        </field>
    </record>

    <!-- action -->
    <record model='ir.actions.act_window' id='easyreport_action'>
        <field name="name">Financial reports</field>
        <field name="res_model">easyfile.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="easyreport_menu" parent="hr_payroll.menu_hr_payroll_report" action="easyreport_action" sequence="-1"/>

    <!-- menu -->
    <record id="view_company_form_inherit" model="ir.ui.view">
        <field name="name">res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="standard_classification"/>
                <field name="building_number"/>
                <field name="building_name"/>
                <field name="commercial_payroll"/>
                <field name="software_package"/>
                <field name="year_of_assessment"/>
                <field name="specification_type"/>
            </field>
        </field>
    </record>
    <record id="res_partner_view_form_private_inherit" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_view_form_private"/>
        <field name="arch" type="xml">
            <field name="street" position="before">
                <field name="street_no" placeholder="Enter Street No"/>
            </field>
        </field>
    </record>
</odoo>
