<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_sheet_view_form_inherit_payroll_travel" model="ir.ui.view">
        <field name="name">hr.expense.sheet.view.form.payroll</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_travel" readonly="state in ['done', 'post']"/>
                <!-- <field name="is_local_expense" readonly="state in ['done', 'post']"/>
                <field name="is_foreign_expense" readonly="state in ['done', 'post']"/> -->
            </xpath>
        </field>
    </record>
</odoo>
