<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <template id="invoice_layout">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>
            <div class="footer o_standard_footer">
                <div class="row" style="border-top:2px solid black;">
                    <div class="col-12" style="font-size:11px;">
                        <div class="row">
                            <div class="col-12 text-start" style="background:#d4d4d4;padding:2px;"><strong>Leave Balances</strong></div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-left:0px;margin-right:0px;font-size:11px;">

                    <t t-set="leave_balances_line" t-value="o.get_leave_balances()"/>
                    <t t-set="total_remaing_live" t-value="0.0"/>
                    <table class="table table-borderless" style="border:none;">
                        <tr>
                            <th style="text-align : left;font-weight:900;padding:1px;margin:0">Description</th>
                            <th style="text-align : right;font-weight:900;padding:1px;margin:0">Balance</th>
                        </tr>
                        <tr t-if="leave_balances_line" t-foreach="leave_balances_line" t-as="line">
                            <td style="text-align : left;padding:1px;margin:0"><strong><span t-esc="line.get('leave_type')"/></strong></td>
                            <td style="text-align : right;padding:1px;margin:0"><span t-esc="line.get('remaining_leaves')" t-options="{'widget': 'float', 'precision': 2}"/></td>
                            <t t-set="total_remaing_live" t-value="total_remaing_live + line.get('remaining_leaves')"/>
                        </tr>
                        <tr style="border-top:2px solid black;">
                            <th style="text-align : left;font-weight:900;padding:1px;margin:0">Total Annual Leave</th>
                            <th style="text-align : right;font-weight:900;padding:1px;margin:0"><span t-esc="abs(total_remaing_live)" t-options="{'widget': 'float', 'precision': 2}"/></th>
                        </tr>
                    </table>
                </div>
            </div>
        </template>
    </data>
</odoo>